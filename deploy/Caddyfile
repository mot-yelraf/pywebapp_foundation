# Same-machine LAN proxy. See docs/deployment.md for credentials and CA trust.
{
    admin off
    auto_https disable_redirects
    skip_install_trust
}
{$PWAF_PUBLIC_ORIGIN} {
    tls internal
    basic_auth {
        operator {$PWAF_OPERATOR_HASH}
        viewer {$PWAF_VIEWER_HASH}
    }
    reverse_proxy 127.0.0.1:{$PWAF_HTTP_PORT:8191} {
        header_up Host {http.request.hostport}
        header_up X-PWAF-User {http.auth.user.id}
        header_up X-PWAF-Proxy-Token {$PWAF_PROXY_TOKEN}
        header_up -Authorization
    }
}
